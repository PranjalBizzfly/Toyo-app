# Contact form delivery (server-only; set in Vercel project settings). Configure ONE option.
# Option 1: POST the JSON payload to a webhook (Zapier, Make, Slack, CRM).
CONTACT_WEBHOOK_URL=
# Option 2: send an email through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional sender, must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=
